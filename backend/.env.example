# Port the API + Socket.IO server listens on
PORT=3001

# Redis connection string. Optional for local development: without it rooms
# live in memory and disappear on restart (don't run production without it).
REDIS_URL=

# The frontend's public origin, allowed by CORS (Vercel preview URLs are always allowed)
FRONTEND_URL=http://localhost:3000

# Set to "production" in production (enables strict CORS and gated debug endpoints)
NODE_ENV=development

# Secret for /metrics?token=... and other debug endpoints in production
DEBUG_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# Focus sessions to add to the all-time count shown on the homepage (sessions
# completed before counting started). Set to 0 on a fresh install.
STATS_BASELINE_SESSIONS=0
